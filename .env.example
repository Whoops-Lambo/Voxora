# Optional backend configuration. Copy to .env and fill private values locally.
# Start explicitly with: node --env-file=.env server.js
PORT=3000
VOXORA_HOST=0.0.0.0
VOXORA_DATA_DIR=.data

# For local source hosting. Use your HTTPS origin when hosting a shared backend.
VOXORA_PUBLIC_URL=http://127.0.0.1:3000

# Never commit real keys. Leave empty to keep purchases disabled.
VOXORA_STRIPE_SECRET_KEY=
VOXORA_STRIPE_WEBHOOK_SECRET=
VOXORA_STRIPE_MONTHLY_PRICE_ID=
VOXORA_STRIPE_YEARLY_PRICE_ID=

# Compose HTTPS hostname (omit the scheme). Keep all clients on the same backend.
VOXORA_DOMAIN=chat.example.com
